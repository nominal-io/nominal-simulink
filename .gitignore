# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
# (*.mod* removed: no kernel modules here, and it silently matched go.mod)
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Build output
build/

# MATLAB/Simulink artifacts
*.mexw64
*.mexa64
*.mexmaci64
slprj/
*.slxc

# Generated by simulink/tools/ and the CMake build, not hand-authored. An .slx is a zipped
# binary, so committing one would put the block's definition somewhere no diff can review
# it. Everything else under blockset/ is what ships, and is committed.
simulink/blockset/library/*.slx
simulink/blockset/examples/
simulink/blockset/doc/html/
simulink/blockset/script/Contents.m
simulink/blockset/codegen/

.claude
.vscode

build-linux/

# Third-party SDKs, fetched locally rather than committed
ext/

# Real proxy config holds a token; only the template is committed
nmproxy/nmproxy.yaml
nmproxy.yaml
